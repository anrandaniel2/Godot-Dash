## Highest object ID the table was generated from. IDs above it are 2.0+
## objects with no verified defaults.
const KNOWN_MAX_ID: int = 1911


## Default base channel for [param gd_id]; [code]0[/code] means untinted.
static func base_channel(gd_id: int) -> int:
	return BASE.get(gd_id, OBJ_CHANNEL)


## Default detail channel for [param gd_id], used when key 22 is absent.
static func detail_channel(gd_id: int) -> int:
	return DETAIL.get(gd_id, DEFAULT_DETAIL_CHANNEL)


static func is_base_black(gd_id: int) -> bool:
	return BLACK_BASE.has(gd_id)


static func is_detail_black(gd_id: int) -> bool:
	return BLACK_DETAIL.has(gd_id)
