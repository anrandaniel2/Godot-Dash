import os
from pathlib import Path

root = Path(Dir('#').abspath)
output = Path(ARGUMENTS['output']).resolve()
output.mkdir(parents=True, exist_ok=True)
SConsignFile(str(output / '.sconsign'))
env = Environment(ENV=os.environ, TARGET_ARCH='amd64')
if env['PLATFORM'] == 'win32':
    env.Append(CXXFLAGS=['/std:c++17', '/O2', '/EHsc', '/W4'])
else:
    env.Append(CXXFLAGS=['-std=c++17', '-O2', '-Wall', '-Wextra', '-Werror'])
obj = env.Object(str(output / 'visibility'), str(root / 'native/tests/test_decoration_visibility_cache.cpp'))
Default(env.Program(str(output / 'visibility-test'), obj))
ui_obj = env.Object(str(output / 'ui-alignment'), str(root / 'native/tests/test_ui_trigger.cpp'))
Default(env.Program(str(output / 'ui-alignment-test'), ui_obj))
spin_obj = env.Object(str(output / 'spin'), str(root / 'native/tests/test_decoration_spin.cpp'))
Default(env.Program(str(output / 'spin-test'), spin_obj))
spin_cache_obj = env.Object(str(output / 'spin-cache'), str(root / 'native/tests/test_decoration_spin_cache.cpp'))
Default(env.Program(str(output / 'spin-cache-test'), spin_cache_obj))
sections_obj = env.Object(str(output / 'compact-sections'), str(root / 'native/tests/test_decoration_sections.cpp'))
Default(env.Program(str(output / 'compact-sections-test'), sections_obj))
frustum_obj = env.Object(str(output / 'frustum-transition'), str(root / 'native/tests/test_frustum_transition_ranges.cpp'))
Default(env.Program(str(output / 'frustum-transition-test'), frustum_obj))
