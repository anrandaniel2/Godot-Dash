[configuration]

entry_symbol = "gdash_native_library_init"
compatibility_minimum = "4.1"

# Keep the runtime selector deliberately minimal. The Android APK is arm64-only,
# so the guaranteed `android` feature is sufficient and avoids relying on ABI or
# template feature tags that are not reaching GDExtensionLibraryLoader on the
# tested Godot 4.7 Android runtime.
[libraries]

linux = "res://native/bin/linux_debug/x86_64/libgdash_native.so"
android = "res://native/bin/android_debug/arm64-v8a/libgdash_native.so"
