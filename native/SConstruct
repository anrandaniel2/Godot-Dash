#!/usr/bin/env python
"""Builds the gdash_native GDExtension shared library.

godot-cpp must be checked out next to this file (native/godot-cpp) at the
pinned revision - see .github/workflows/main.yml, which also installs the
Android NDK and runs:

    scons platform=android target=template_debug arch=arm64 \
          api_version=4.7 ndk_version=28.1.13356709

api_version pins the Godot extension API (project.godot is 4.7); godot-cpp
master (v10) is required because no 4.6/4.7 godot-cpp tag exists yet. The
built library lands in native/bin as
libgdash_native.<platform>.<target>.<arch>.so; CI copies it to the
res://native/bin/android_debug/arm64-v8a/ path the .gdextension file
references.

A desktop smoke build works too (no NDK needed):

    scons platform=linux target=template_debug
"""

import os

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])

sources = Glob("src/*.cpp")

library = env.SharedLibrary(
    "bin/libgdash_native{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)

Default(library)
