#!/usr/bin/env python
"""Build gdash_native using the official godot-cpp project layout.

The generated filename retains godot-cpp's platform/target/architecture suffix
and is installed below bin/<platform>/ beside bin/gdash_native.gdextension.
This mirrors godot-cpp's own test project and godot-cpp-template instead of
renaming the library into a custom ABI directory after compilation.
"""

env = SConscript("godot-cpp/SConstruct", {"api_version": "4.7"})
env.Append(CPPPATH=["src/"])

sources = Glob("src/*.cpp")
library = env.SharedLibrary(
    "bin/{}/libgdash_native{}{}".format(
        env["platform"], env["suffix"], env["SHLIBSUFFIX"]
    ),
    source=sources,
)

env.NoCache(library)
Default(library)
